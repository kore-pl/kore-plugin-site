{
  "id": "site",
  "name": "Nginx 站点管理插件",
  "version": "0.8.3",
  "protocol": "kore.plugin.v1",
  "lifecycle": "resident",
  "depth_level": "production",
  "entry": "bin/site",
  "capabilities": [
    "system:admin"
  ],
  "requires_root": true,
  "root_actions": [
    {
      "id": "nginx-test",
      "argv": [
        "nginx",
        "-t"
      ],
      "timeout_s": 20,
      "description": "校验 nginx 配置语法（nginx -t）。降权后插件以 kore-site 运行，读 root 才能读的配置与私钥需要 root，故经内核提权通道执行"
    },
    {
      "id": "nginx-reload",
      "argv": [
        "nginx",
        "-s",
        "reload"
      ],
      "timeout_s": 20,
      "description": "热重载 nginx 配置（nginx -s reload）。给 root master 发信号需要 root；不提供 stop/quit——停服等于 Denial of Service"
    },
    {
      "id": "nginx-dump",
      "argv": [
        "nginx",
        "-T"
      ],
      "timeout_s": 20,
      "description": "打印已加载的完整配置并校验语法（nginx -T，只读）。用于读取 /etc/nginx 下现有 vhost 的实际生效内容"
    },
    {
      "id": "vhost-write",
      "file_write": {
        "prefix_class": "nginx.conf.d",
        "mode": "0644",
        "content_policy": "nginx.vhost.v1",
        "max_bytes": 262144
      },
      "writes_host": true,
      "target": "/etc/nginx/conf.d/",
      "description": "写站点 vhost 片段（内核受控写，ADR-0052）：文件名 kore-site-<domain>.conf、属主 root:root 0644；不执行外部命令"
    },
    {
      "id": "vhost-delete",
      "file_delete": {
        "prefix_class": "nginx.conf.d"
      },
      "writes_host": true,
      "target": "/etc/nginx/conf.d/",
      "description": "删除站点 vhost 片段（内核受控删除，ADR-0053）：文件名 kore-site-<domain>.conf；删前内核强制备份进 <install>/data/backups，账本 purge_op=file.restore；不执行外部命令"
    }
  ],
  "method_capabilities": {
    "site.list": "system:read",
    "site.create": "system:admin",
    "site.delete": "system:admin",
    "site.status": "system:read",
    "site.get": "system:read",
    "site.bindSSL": "system:admin",
    "site.unbindSSL": "system:admin",
    "site.setRewrite": "system:admin",
    "site.getRewrite": "system:read",
    "site.setProxy": "system:admin",
    "site.unsetProxy": "system:admin",
    "site.setRedirect": "system:admin",
    "site.unsetRedirect": "system:admin",
    "site.disable": "system:admin",
    "site.enable": "system:admin",
    "site.setIndex": "system:admin",
    "site.config.get": "system:read",
    "site.config.set": "system:admin",
    "site.clone": "system:admin",
    "site.setPassword": "system:admin",
    "site.clearPassword": "system:admin",
    "site.traffic": "system:read",
    "site.setPHP": "system:admin",
    "site.unsetPHP": "system:admin",
    "site.getPHP": "system:read"
  },
  "triggers": [],
  "requires_kore": ">=0.1.1 <0.2.0",
  "resources": {
    "memory_mb": 8,
    "cpu_quota": "20%",
    "pids_max": 32
  },
  "depends_on": [],
  "conflicts": [],
  "scenario_tags": [
    "web",
    "ops"
  ],
  "size_bytes": 2955583
}
